# 复制本文件为 .env 后填写（不要提交 .env 到 Git）
# 外网访问时必须设置密码

# 访问密码（必填）
BILL_ACCESS_PASSWORD=912614

# 会话密钥（随便一长串，不要告诉别人）
BILL_SECRET_KEY=请换成随机字符串

# 隧道走 HTTPS 时设为 1；本机 HTTP 调试设为 0
BILL_COOKIE_SECURE=0

# 诗境大模型（可选；智谱示例）
# POEM_LLM_API_KEY=
# POEM_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# POEM_LLM_MODEL=glm-4-flash
