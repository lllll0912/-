# ASCII-only patterns (remote builder rejects non-ASCII in .dockerignore)
# Large image dirs are omitted by selective COPY in 脚本/Dockerfile (not COPY .)
.venv
__pycache__
*.pyc
.env
.env.*
.git
.github
data/
backup/
backups/
deploy-repo/
tests/
legacy/
*.bat
*.ps1
*.xlsx
*.docx
tunnel_*.log
node_modules/
